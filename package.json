{
  "name": "planning-poker",
  "version": "1.0.0",
  "private": true,
  "description": "Scrum planning poker: rooms synced through a small WebSocket relay on Cloudflare.",
  "scripts": {
    "dev": "next dev",
    "dev:server": "npm --prefix server run dev",
    "build": "next build",
    "start": "next start",
    "test": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "npm --prefix server run typecheck",
    "format": "prettier --write .",
    "lint": "eslint ."
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
